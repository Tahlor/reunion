# Add these locations inside the existing HTTPS server block for
# taylorarchibald.com. The public reunion page stays static, while edit/admin/API
# requests go to the SSO-aware reunion service on 127.0.0.1:13041.

location = /reunion {
    return 301 /reunion/;
}

location = /reunion/rsvp {
    return 301 /reunion/rsvp/;
}

location = /reunion/edit {
    proxy_pass http://127.0.0.1:13041;
    include proxy_params;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_read_timeout 60s;
    add_header Cache-Control "no-store, max-age=0" always;
}

location = /reunion/admin {
    proxy_pass http://127.0.0.1:13041;
    include proxy_params;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_read_timeout 60s;
    add_header Cache-Control "no-store, max-age=0" always;
}

location = /reunion/health {
    proxy_pass http://127.0.0.1:13041;
    include proxy_params;
}

location = /reunion/sso/login {
    proxy_pass http://127.0.0.1:13041;
    include proxy_params;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    add_header Cache-Control "no-store, max-age=0" always;
}

location /reunion/api/ {
    proxy_pass http://127.0.0.1:13041;
    include proxy_params;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_read_timeout 60s;
    client_max_body_size 2m;
    add_header Cache-Control "no-store, max-age=0" always;
}

# Keep config.js fresh so the RSVP URL appears immediately after deployment.
location = /reunion/config.js {
    alias /var/www/taylorarchibald.com/reunion/config.js;
    default_type application/javascript;
    add_header Cache-Control "no-store, max-age=0" always;
    add_header X-Content-Type-Options "nosniff" always;
}

location /reunion/ {
    alias /var/www/taylorarchibald.com/reunion/;
    index index.html;
    autoindex off;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
